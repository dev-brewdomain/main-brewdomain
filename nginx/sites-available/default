# Redirect www to non-www
server {
    server_name www.brewdomain.org;
    return 301 http://brewdomain.org$request_uri;

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/brewdomain.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/brewdomain.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

# Main server block (acts as default server for IP and domain)
server {

    server_name brewdomain.org home.brewdomain.org 45.32.89.196 _;

	   # Check if the user agent is marked as bad
    if ($bad_bot) {
        return 444; # Drops Connection Better than a 404 to conserve resources
    }

    root /var/www/brewdomain.org;
    index index.html;

    location /nginx_status {
        stub_status;
        allow 127.0.0.1;
        deny all;
    }

    location /api/stats {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;    
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ^~ /images/ {
        alias /nginx.files/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/brewdomain.org-0001/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/brewdomain.org-0001/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot



}

server {
    if ($host = home.brewdomain.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = brewdomain.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80 default_server;
    listen [::]:80 default_server;

    server_name brewdomain.org home.brewdomain.org 45.32.89.196 _;
    return 404; # managed by Certbot




}
server {
    if ($host = www.brewdomain.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name www.brewdomain.org;
    return 404; # managed by Certbot


}
